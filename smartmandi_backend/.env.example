# Copy to .env and fill in real values. Never commit .env itself.

# MongoDB connection string. Omit to run the API without a database
# (read endpoints will then return 503 rather than fabricated data).
MONGODB_URI=mongodb://localhost:27017/smartmandi

# Port the Express API listens on. The frontend dev proxy expects 5000.
PORT=5000

# development | production. Controls whether error responses include details.
NODE_ENV=development

# Interpreter used to run python/modelService.py. Set to python3, or an
# absolute path to a virtualenv interpreter, if plain `python` is not on PATH.
PYTHON_BIN=python
